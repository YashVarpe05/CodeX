{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "app/team/page.jsx", "components/Team.jsx", "components/Yash.jsx", "components/Yogesh.jsx", "components/Tanishq.jsx", "components/Shubham.jsx", "components/Sayali.jsx", "components/Sagar.jsx", "components/PratikS.jsx", "components/Pratik.jsx", "components/Om.jsx", "components/Harshad.jsx", "components/Darshana.jsx"],
  "exclude": ["node_modules"]
}
